{
  "name": "@unpanel/site",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.ts --outDir node_modules/.cache/site-ssr --emptyOutDir && node scripts/prerender.mjs",
    "preview": "vite preview",
    "shots": "node shots/capture.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@unpanel/shared": "workspace:*",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "playwright": "^1.64.0",
    "vite": "^8.0.0",
    "vue-tsc": "^3.1.0"
  }
}
